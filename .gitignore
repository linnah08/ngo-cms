# Operator scripts (prod tunnel, prod sync, worktree helper) and their artifacts.
# Removed from the published repo in 7f3205e "Scrub personal infra" because they
# name this operator's own server and SSH alias. They are still needed locally —
# CLAUDE.md's "Database querying" section documents them — so they live here
# untracked rather than being deleted again.
scripts/

# Self-update mechanism (includes/updater.php) — runtime state, not source.
# checksums.json ships inside the release ZIP (generated by build-release.yml)
# and lands in the project root when a release is unzipped or applied.
/checksums.json
/backups/
/.maintenance
