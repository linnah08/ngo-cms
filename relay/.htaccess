# Defence in depth: this directory must never be web-served (only public/ is the document root).
# If the subdomain's document root is ever mis-pointed here, deny everything.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
